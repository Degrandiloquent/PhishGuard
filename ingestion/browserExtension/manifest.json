{
  "manifest_version": 3,
  "name": "PhishGuard - Email & Link Protection",
  "version": "1.0.0",
  "description": "AI-powered real-time phishing detection and threat prevention for Gmail, Outlook, and the web",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://gmail.com/*",
    "https://mail.google.com/*",
    "https://outlook.office.com/*",
    "https://mail.live.com/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background/backgroundScript.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://gmail.com/*", "https://mail.google.com/*"],
      "js": ["content/contentScript.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://outlook.office.com/*", "https://mail.live.com/*"],
      "js": ["content/contentScript.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/contentScript.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
